# Copy to .env for local testing, and add the same values in Netlify:
# Site configuration > Environment variables

# --- Email: option 1, Gmail (easiest for a demo; can email anyone) ---
# Use a Gmail "App password" (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password

# --- Email: option 2, Resend (needs a verified domain to email customers) ---
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Zicco Plumbers <tickets@ziccoplumbersgp.co.za>

# Where new requests, replies and copies of quotes/invoices go (can also be set in dashboard Settings)
BUSINESS_EMAIL=owner@example.com

# Dashboard logins (name:password, comma separated). Default demo login is admin / zicco-demo
# ADMIN_USERS=Ntsikelelo:choose-a-password,Office:another-password
# SESSION_SECRET=any-long-random-string-at-least-32-characters

# Optional
# GOOGLE_REVIEW_URL=https://g.page/r/xxxx/review
# SITE_URL=https://ziccoplumbersgp.co.za
