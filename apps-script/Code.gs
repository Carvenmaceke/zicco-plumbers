      if (path === "/api/tickets") return req.method === "POST" ? createRequest(req) : err("Method not allowed", 405);
      if (path === "/api/track" || path.indexOf("/api/track/") === 0) return track(path.replace(/^\/api\/track\/?/, ""), req);
      if (path === "/api/doc" || path.indexOf("/api/doc/") === 0) return docPublic(path.replace(/^\/api\/doc\/?/, ""), req);
      if (path.indexOf("/api/admin/") === 0) return admin(path.replace(/^\/api\/admin\/?/, "").split("/").filter(Boolean).map(decodeURIComponent), req);
      return err("Not found", 404);
    } catch (e) {
      return err(e && e.message || "Something went wrong", 500);
    }
  }
  function doPost(e) {
    let req = {};
    try {
      req = JSON.parse(e.postData.contents);
    } catch (x) {
      req = {};
    }
    if (req.site && /^https?:\/\/[^\s"<>]+$/.test(req.site) && !props2().getProperty("SITE_URL")) props2().setProperty("SITE_URL", String(req.site).slice(0, 200));
    return ContentService.createTextOutput(JSON.stringify(handle(req))).setMimeType(ContentService.MimeType.JSON);
  }
  function doGet() {
    return ContentService.createTextOutput(JSON.stringify({ ok: true, service: "Zicco Plumbers backend" })).setMimeType(ContentService.MimeType.JSON);
  }
  function setup() {
    const p2 = props2();
    sheet(TICKET_SHEET);
    sheet(DOC_SHEET);
    if (!p2.getProperty("SESSION_SECRET")) p2.setProperty("SESSION_SECRET", Utilities.getUuid() + Utilities.getUuid());
    if (!p2.getProperty("ADMIN_USERS")) p2.setProperty("ADMIN_USERS", "admin:" + Utilities.getUuid().replace(/-/g, "").slice(0, 12));
    if (!p2.getProperty("BUSINESS_EMAIL")) p2.setProperty("BUSINESS_EMAIL", Session.getEffectiveUser().getEmail());
    photoFolder();
    ScriptApp.getProjectTriggers().filter((t) => t.getHandlerFunction() === "dailyJob").forEach((t) => ScriptApp.deleteTrigger(t));
    ScriptApp.newTrigger("dailyJob").timeBased().atHour(6).everyDays(1).inTimezone("Africa/Johannesburg").create();
    MailApp.getRemainingDailyQuota();
    const login = p2.getProperty("ADMIN_USERS").split(",")[0];
    const msg = "Setup complete.\n\nDashboard login: " + login.replace(":", " / ") + "\nNotifications go to: " + p2.getProperty("BUSINESS_EMAIL") + "\nWebsite address: " + (SITE_URL.indexOf("ziccoplumbers.co.za") < 0 || p2.getProperty("SITE_URL") ? SITE_URL : "not set yet: paste it into WEBSITE_URL at the top of the script (or it's learned from the first visit)");
    console.log(msg);
    return msg;
  }
  function dailyJob() {
    return runDaily();
  }
  return __toCommonJS(backend_exports);
})();

// Entry points Google calls by name.
function doPost(e) { return ZP.doPost(e); }
function doGet(e) { return ZP.doGet(e); }
function setup() { return ZP.setup(); }
function dailyJob() { return ZP.dailyJob(); }
